VITE_PORT=5173
VITE_APP_TITLE="EduCloud Super Admin"

# API Base URL (Relative /api leverages Vite dev proxy; use full URL in standalone production)
VITE_API_BASE_URL="/api"

# Backend Server URL (Used by Vite dev proxy)
VITE_BACKEND_URL="http://localhost:5000"
